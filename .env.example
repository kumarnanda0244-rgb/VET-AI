# VETAI Environment Configuration
# Copy this file to .env to configure your local environment settings

# Flask Application Secret Key for sessions
SECRET_KEY=vetai-super-secret-key-change-in-production

# Server Configuration
PORT=5000
HOST=127.0.0.1
DEBUG=True

# Optional AI Vision API Credentials
# If left empty, VETAI will automatically use its built-in rule-based 
# clinical decision support system and OpenCV image quality checks.
GEMINI_API_KEY=
OPENAI_API_KEY=
